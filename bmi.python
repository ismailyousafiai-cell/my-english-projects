# BMI Calculator - By Ismail - Project 56
print("My BMI Calculator")

weight = float(input("Enter Weight (KG): "))
height = float(input("Enter Height (Meter): "))

bmi = weight / (height * height)
print("Your BMI:", round(bmi, 1))

if bmi < 18.5:
    print("Low!")
elif bmi < 25:
    print("Perfect! Good!")
else:
    print("High!")